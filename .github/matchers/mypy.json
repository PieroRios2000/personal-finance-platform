{
  "problemMatcher": [
    {
      "owner": "mypy",
      "pattern": [
        {
          "regexp": "^(.+?):(\\d+):\\s+(error|warning|note):\\s+(.+?)(?:\\s{2,}\\[(.+?)\\])?$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4,
          "code": 5
        }
      ]
    }
  ]
}
