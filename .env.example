# Copy this file to .env and fill in the values; .env is in .gitignore.
# This file DOES get committed to Git: never put real values in here.

# Passwords for the bank statement PDFs (T11, T18)
BCP_PDF_PASSWORD=
SCOTIABANK_PDF_PASSWORD=

# Lake location: s3://… with local S3, or a disk path (ADR 0006, T14)
LAKEHOUSE_URI=s3://lakehouse

# Local S3 with SeaweedFS (T13, ADR 0003): `make poc-up` / `make poc-down`.
# SEAWEEDFS_S3_PORT is the host port docker-compose.yml publishes; keep it in sync
# with the port in AWS_ENDPOINT_URL if you change it (e.g. to run two instances at once).
SEAWEEDFS_S3_PORT=8333
AWS_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# HMAC key that turns a bank + account number into account_id (ADR 0005, T6); see SETUP.md
PFP_ACCOUNT_KEY=

# Default user for pfp ingest/parse when --user isn't passed (ADR 0009, T6)
PFP_USER=

# Target module for `dagster asset list`/`dagster asset materialize` (T21, SETUP.md
# section 9) -- these two commands need it explicitly; `dagster dev` doesn't (it reads
# pyproject.toml's own [tool.dagster] block instead).
DAGSTER_MODULE_NAME=orchestration.definitions

# Alerting (Phase 7, SETUP.md section 11). Leave a channel's variables empty to
# turn it off; both can be on. These are secrets: never commit real values.
# `.env` is sourced by the shell: wrap values in single quotes when they contain
# spaces, `&`, `$` or `#` (Teams URLs contain `&`; Gmail-style app passwords have
# spaces), e.g. ALERT_TEAMS_WEBHOOK_URL='https://...&sig=...'.
# Email over SMTP with STARTTLS:
ALERT_SMTP_HOST=
ALERT_SMTP_PORT=587
ALERT_SMTP_USER=
ALERT_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
# Microsoft Teams: the URL of a Workflows "webhook request" trigger.
ALERT_TEAMS_WEBHOOK_URL=
# Where warnings wait for the weekly digest (default: ~/finance-data/alerts/warnings.jsonl).
ALERT_QUEUE_PATH=

# PostgreSQL, dbt's store for silver and gold (ADR 0029, T26; SETUP.md section 6).
# `make pg-up` starts it. PFP_PG_PASSWORD and PFP_PG_BI_PASSWORD are secrets: generate them
# (e.g. `openssl rand -hex 16`; hex has no special characters, and if you pick your own, wrap
# the value in single quotes because `.env` is sourced by the shell). PFP_PG_BI_PASSWORD is for
# the read-only role BI tools use; it is only read when the volume is first created.
PFP_PG_HOST=127.0.0.1
PFP_PG_PORT=5432
PFP_PG_DATABASE=pfp
PFP_PG_USER=pfp
PFP_PG_PASSWORD=
PFP_PG_BI_PASSWORD=

# Apache Superset (T32, ADR 0030; SETUP.md section 12): `make bi-up`. Three secrets, same advice
# as above (`openssl rand -hex 16`; the secret key `openssl rand -base64 42`, in single quotes).
# PFP_BI_DB_PASSWORD: Superset's own role in the `superset` database of the same Postgres.
# PFP_BI_ADMIN_PASSWORD: the `admin` account `bi/build_dashboards.py` uses to author the dashboards
# over the REST API (T39, ADR 0034); people sign in with their own email through Dex instead, below.
# PFP_BI_SECRET_KEY: signs Superset's sessions.
PFP_BI_DB_PASSWORD=
PFP_BI_ADMIN_PASSWORD=
PFP_BI_SECRET_KEY=
# Optional: host port for Superset (default 8088), if that one is taken.
PFP_BI_PORT=8088

# Dex (T39, ADR 0034; SETUP.md section 12): one login per person, by email, instead of a shared
# admin password per tool. Accounts live in Dex, not in this file (ADR 0039): create yours with
# `make dex-add-user EMAIL=you@example.com` once the stack is up, or on the sign-up page.
# PFP_BI_OAUTH_CLIENT_SECRET is generated like the secrets above.
PFP_BI_OAUTH_CLIENT_SECRET=
DEX_ISSUER=http://localhost:5556/dex
# Optional: host port for Dex (default 5556), if that one is taken.
PFP_DEX_PORT=5556

# dex-register (T40, ADR 0035; SETUP.md section 12): a friendly sign-up page at
# http://localhost:5559, so someone can add themselves instead of you running
# `make dex-add-user` for them. PFP_DEX_INVITE_CODE is generated like the secrets above --
# share it (not this file) with whoever you want to be able to sign up; anyone without it
# is refused. Never commit a real value.
PFP_DEX_INVITE_CODE=
# Optional: host port for dex-register (default 5559), if that one is taken.
PFP_DEX_REGISTER_PORT=5559
# Password reset (T43, ADR 0038): the public address of dex-register (no trailing slash), for
# the login form's links and the emailed reset link, e.g. https://register.<your domain>.
# Leave empty to stay local; the reset email also needs the ALERT_SMTP_* variables above.
PFP_REGISTER_PUBLIC_URL=

# Upload portal (T44, ADR 0040; SETUP.md section 12): signed-in people send their bank
# statements at http://localhost:5560; each lands, unlocked, in its own folder of the inbox
# (PFP_INBOX_DIR, default ~/finance-data/inbox) for you to process with `pfp ingest`. The
# secrets are generated like the others. PFP_UPLOAD_PUBLIC_URL is its public address (no
# trailing slash, e.g. https://upload.<your domain>); leave empty to stay local.
PFP_UPLOAD_SECRET_KEY=
PFP_UPLOAD_OAUTH_CLIENT_SECRET=
PFP_UPLOAD_PUBLIC_URL=
# Optional: a banner shown at the top of the portal (e.g. a demo-environment notice).
# Leave empty for none.
PFP_UPLOAD_NOTICE=
# Optional: host port for the portal (default 5560); the user/group id the container runs as.
PFP_UPLOAD_PORT=5560
PFP_UID=1000
PFP_GID=1000
# Optional public URL (T42, ADR 0037; SETUP.md section 12): the token of a Cloudflare Tunnel
# (`make up` then also starts the `cloudflared` connector) and the public address of Superset,
# without a trailing slash. Also point DEX_ISSUER at Dex's public address (https://login.<your
# domain>/dex). Leave both empty to stay local only. The token is a secret: never commit it.
PFP_TUNNEL_TOKEN=
PFP_BI_PUBLIC_URL=

# Row-level data (T41, ADR 0036; SETUP.md section 12): whoever signs in to Superset with
# this email gets to see everything (Admin); everyone else sees only the user_id their
# own Dex account was explicitly scoped to (`make dex-add-user --username`), or nothing
# at all by default. Not a secret, but real: your own email, not committed for real.
PFP_BI_OWNER_EMAIL=

# OpenMetadata (T24; `make up-catalog`): host port of its UI, moved per environment (ADR 0033).
OPENMETADATA_PORT=8585
