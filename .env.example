# Copia este archivo a .env y rellena los valores; .env está en .gitignore.
# Este archivo sí se sube a Git: nunca pongas valores reales aquí.

# Contraseñas de los PDFs de estado de cuenta (T11, T18)
BCP_PDF_PASSWORD=
SCOTIABANK_PDF_PASSWORD=

# Ubicación del lake: s3://… con el S3 local, o una ruta de disco (ADR 0006, T14)
LAKEHOUSE_URI=s3://lakehouse

# S3 local con SeaweedFS (T13)
AWS_ENDPOINT_URL=http://localhost:8333
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
