{{#each data}}
<div class="kpis">
  <div class="kpi income"><div class="label">Money in</div>
    <div class="value">{{currency}} {{money_in}}</div><div class="note">incl. transfers between your accounts</div></div>
  <div class="kpi spend"><div class="label">Money out</div>
    <div class="value">{{currency}} {{money_out}}</div><div class="note">incl. transfers between your accounts</div></div>
  <div class="kpi net {{#if net_positive}}pos{{else}}neg{{/if}}"><div class="label">Net saved</div>
    <div class="value">{{currency}} {{net}}</div><div class="note">in minus out</div></div>
  <div class="kpi rate {{#if rate_positive}}pos{{else}}neg{{/if}}"><div class="label">% saved</div>
    <div class="value">{{savings_rate}}</div><div class="note">net &divide; income, no transfers</div></div>
  <div class="kpi count"><div class="label">Movements</div>
    <div class="value">{{movements}}</div><div class="note">in the filtered period</div></div>
</div>
{{/each}}
