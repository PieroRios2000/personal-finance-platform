# Secrets: never to Git (the template is .env.example)
.env
.env.*
!.env.example
*.pem
*.key

# Personal Compose overrides (T40, ADR 0035): which network reaches your own Cloudflare
# Tunnel, machine-specific. The template is docker-compose.override.yml.dist.
docker-compose.override.yml

# Real financial data: lives outside the repo (~/finance-data) and in the lake
*.[pP][dD][fF]
data/

# Local lake and embedded databases
*.duckdb
*.duckdb.wal
*.parquet
_delta_log/

# dbt's own generated output (T17): compiled SQL, manifest.json, run_results.json,
# dbt.log. `make poc` and CI's ephemeral-integration job both run `dbt build`
# without overriding --target-path/--log-path, which is what puts these under
# dbt/ instead of a tmp_path (tests/test_dbt_silver_integration.py always
# overrides both, so this never applies to the test suite).
dbt/target/
dbt/logs/
# `edr`'s own default --target-path (T22): logs and a temp results file from a
# local `edr report`/`edr monitor` run with no --target-path override.
edr_target/

# Python and tooling
.venv/
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
.import_linter_cache/
# Saved benchmark runs (T15): a timing only means something on the machine
# that produced it, so they are never shared through Git.
.benchmarks/

# Local Obsidian config (the vault is brain/)
.obsidian/

# Claude Code agent working copies (git worktrees)
.claude/worktrees/

# OpenMetadata (T24): the dbt artifacts and generated workflow config the ingestion
# container reads (holds a short-lived admin token) -- written by scripts/openmetadata_sync.py.
openmetadata/artifacts/
